import subprocess
import sys
import os
import re
import time
import pexpect
import threading
from pexpect.popen_spawn import PopenSpawn

# thread used for copying simulation output to sim.log
class IOThread(threading.Thread):
    def __init__(self, p):
        super(IOThread, self).__init__(target=p.expect, args=(pexpect.EOF,))
        daemon = True

def try_kill(proc, signum = 15, attempts = 5):
    for attempt in range(attempts):
        try:
            proc.kill(signum)
            return
        except Exception:
            time.sleep(0.1)

env = os.environ
io = {}

for var in [v for v in re.split(r'(?<!\\);', '@env@') if v]:
    val = var.split('=', 1)
    env[val[0].strip()] = val[1].strip() if len(val) > 1 else ''
for var, val in env.items():
    print(f'{var} = {val}')

cmd = ['$<TARGET_FILE:silkit_registry>']
log = open(f'pr.log', 'w')
pr = PopenSpawn(cmd, env=env, logfile=log, timeout=None, encoding='utf-8')
pr.expect('SIL Kit Registry listening on silkit://localhost:8500')
io[0] = IOThread(pr)
io[0].start()


if '@mode@' != 'autonomous':
    cmd = ['$<TARGET_FILE:silkit_system_controller>']
    cmd.extend('@ARGN@'.split(';'))
    log = open('pc.log', 'w')
    pc = PopenSpawn(cmd, env=env, logfile=log, timeout=None, encoding='utf-8')
    io[1] = IOThread(pc)
    io[1].start()
    pc.expect('Creating participant \'SystemController\' with registry silkit://localhost:8500')

part = []
i = 0
for var in '@ARGN@'.split(';'):
    cmd = ['$<TARGET_FILE:@nm@>']
    cmd.extend(['-c', f'system.participant.mode=@mode@'])
    cmd.extend(['-c', f'system.participant.name={var}'])
    cmd.append('@CMAKE_CURRENT_SOURCE_DIR@')
    log = open(f'part{i}.log', 'w')
    part.append(PopenSpawn(cmd, env=env, logfile=log, timeout=None, encoding='utf-8'))
    io[2] = IOThread(part[i])
    io[2].start()
    part[i].expect('SilKit Version: 4.0.56')
    i += 1

result = 0
for p in part:
    res = p.wait()
    if res != 0 and result == 0:
        result = res

if '@mode@' != 'autonomous':
    try_kill(pc, 15)
    pc.wait()

pr.kill(15)
pr.wait()

if res != 0:
    print('!!! simulation terminated with error !!!')
    print('!!! Registry output !!!')
    with open('pr.log', 'r') as file:
        print(file.read())
    if '@mode' != 'autonomous':
        print('!!! Controller output !!!')
        with open('pr.log', 'r') as file:
            print(file.read())
    for i in range(len(part)):
        print(f'!!! Participant {i} output !!!')
        with open(f'part{i}.log', 'r') as file:
            print(file.read())

sys.exit(result)
