import subprocess
import sys
import os
import re
import time
from pexpect.popen_spawn import PopenSpawn

def try_kill(proc, signum = 15, attempts = 5):
    for attempt in range(attempts):
        try:
            proc.kill(signum)
            return
        except Exception:
            time.sleep(0.1)

log = sys.stdout
env = os.environ

for var in [v for v in re.split(r'(?<!\\);', '@env@') if v]:
    val = var.split('=', 1)
    env[val[0].strip()] = val[1].strip() if len(val) > 1 else ''
for var, val in env.items():
    print(f'{var} = {val}')

cmd = ['$<TARGET_FILE:silkit_registry>']
pr = PopenSpawn(cmd, env=env, logfile=log, timeout=None, encoding='utf-8')
pr.expect('SIL Kit Registry listening on silkit://localhost:8500')

if '@mode@' != 'autonomous':
    cmd = ['$<TARGET_FILE:silkit_system_controller>']
    cmd.extend('@ARGN@'.split(';'))
    pc = PopenSpawn(cmd, env=env, logfile=log, timeout=None, encoding='utf-8')
    pc.expect('Creating participant \'SystemController\' with registry silkit://localhost:8500')

part = []
i = 0
for var in '@ARGN@'.split(';'):
    cmd = ['$<TARGET_FILE:@nm@>']
    cmd.extend(['-c', f'system.participant.mode=@mode@'])
    cmd.extend(['-c', f'system.participant.name={var}'])
    cmd.append('@CMAKE_CURRENT_SOURCE_DIR@')
    print(cmd)
    part.append(PopenSpawn(cmd, env=env, logfile=log, timeout=None, encoding='utf-8'))
    part[i].expect('SilKit Version: 4.0.56')
    i += 1

result = 0
for p in part:
    res = p.wait()
    if res != 0 and result == 0:
        result = res

if '@mode@' != 'autonomous':
    try_kill(pc, 15)
    pc.wait()

pr.kill(15)
pr.wait()

sys.exit(result)
